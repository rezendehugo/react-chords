# Multi-stage build for react-chords library
FROM node:20-alpine AS builder

WORKDIR /lib

# Install git (required for yarn to install from git dependencies)
RUN apk add --no-cache git

# Copy package files
COPY package.json yarn.lock babel.config.json ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Copy source code
COPY src ./src

# Build library
RUN yarn run build

# Stage 2: Runtime stage
FROM node:20-alpine

WORKDIR /lib

COPY --from=builder /lib/lib ./lib
COPY --from=builder /lib/package.json ./package.json

CMD ["tail", "-f", "/dev/null"]
